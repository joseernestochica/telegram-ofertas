# --- Entorno ---
STAGE=dev
PORT=3020
# URL pública del API (webhook, enlaces en emails, tracking de clics en fichas → GET /api/track/deals/:id)
APP_PUBLIC_URL=https://gangabot.com

# --- Base de datos ---
DB_HOST=localhost
# Debe coincidir con el puerto publicado en docker-compose (30432 -> 5432 en el contenedor)
DB_PORT=30432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gangabot

# --- Telegram ---
TELEGRAM_API_URL=https://api.telegram.org/bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
# Texto legal de afiliado Amazon en la leyenda del canal (normativa según uso; muchos canales lo omiten).
TELEGRAM_AFFILIATE_DISCLAIMER=false
# Si true y el deal no tiene telegram_offer_url: enlazar la publicación con la URL de Amazon ?tag=… (sin pasar por /api/track).
TELEGRAM_PUBLISH_USE_AFFILIATE_URL=false

# --- Amazon Afiliados (Ganga Bot — Amazon.es) ---
# Partner tag / ID de afiliado (ver docs/varios/cuenta-amazon-afiliados.md)
AMAZON_AFFILIATE_TAG=gangabot06-21
AMAZON_MARKETPLACE=www.amazon.es

# --- Keepa ---
KEEPA_API_KEY=

# --- Amazon PA-API 5.0 ---
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=
PAAPI_HOST=webservices.amazon.es
PAAPI_REGION=eu-west-1

# --- API (escritura / admin) ---
# POST, PATCH y rutas /seed: Authorization: Bearer <valor> o cabecera x-api-key
API_KEY=

# --- Deals (ingesta) ---
# Si true, el upsert sin status explícito deja el deal en APPROVED; si false, en PENDING.
DEAL_AUTO_APPROVE=false
# Opcional en upsert: telegramOfferUrl — URL corta para el canal (p. ej. https://amzlink.to/…); prioridad sobre tracking/afiliado.

# --- Publicación automática al canal (cron; ventana y tope en UTC) ---
PUBLISH_ENABLED=true
PUBLISH_CRON=*/10 * * * *
PUBLISH_MAX_PER_DAY=6
PUBLISH_WINDOW_START=9
PUBLISH_WINDOW_END=22
